---
import { themes } from '../lib/themes.mjs';
const {
  theme = themes[0],
  large = false,
  id,
  command = 'git status',
  errorPreview = false,
} = Astro.props;
const style = `--accent:${theme.colors[0]};--path:${theme.colors[1]};--muted:${theme.colors[2]};--error:${theme.colors[3]};--terminal-bg:${theme.backdrop};`;
---

<div
  class:list={['terminal', { large, light: theme.tone === 'light' }]}
  style={style}
  id={id}
  data-layout={theme.layout}
>
  <div class="terminal-bar">
    <span class="window-dots" aria-hidden="true">
      <i></i>
      <i></i>
      <i></i>
    </span>
    <span>
      moodsh <span class="terminal-bar-slash">/</span>{' '}
      <span data-mood-name>{theme.name}</span>
    </span>
    <span class="terminal-mark" aria-hidden="true">
      ↗
    </span>
  </div>
  <div class="terminal-body">
    <div class="terminal-comment"># a little more you</div>
    <div class="prompt-line">
      <span class="mood-label" data-mood-label>
        {theme.name}{' '}
      </span>
      <span class="prompt-path">~/code/good-things</span>
      <span class="prompt-command">
        <span class="prompt-arrow"> &gt; </span>
        <span>{command}</span>
      </span>
    </div>
    <div class="terminal-output">
      On branch main
      <br />
      Your branch is up to date.
      <br />
      <br />
      nothing to commit, working tree clean
    </div>
    <div class="prompt-line">
      <span class="mood-label" data-mood-label>
        {theme.name}{' '}
      </span>
      <span class="prompt-path">~/code/good-things</span>
      <span class="prompt-command">
        <span class="prompt-arrow"> &gt; </span>
        <span class="cursor" aria-hidden="true"></span>
      </span>
    </div>
    {errorPreview && (
      <div class="error-preview">
        <div class="terminal-comment"># after a failed command</div>
        <div class="prompt-line">
          <span class="mood-label" data-mood-label>
            {theme.name}{' '}
          </span>
          <span class="prompt-path">~/code/good-things</span>
          <span class="prompt-error"> [1]</span>
          <span class="prompt-command">
            <span class="prompt-error"> &gt;</span>
          </span>
        </div>
      </div>
    )}
  </div>
</div>
