---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/manrope';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/global.css';
const {
  title = 'Mood Shell · Make your shell feel like yours.',
  description = 'A small Rust toolkit for a more personal terminal. Find your colors, customize your prompt, and share themes as Markdown.',
  page = '',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://moodsh.vercel.app/social.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="site-shell">
      <header class="site-header">
        <a href="/" class="wordmark" aria-label="moodsh home">
          <span class="logo" aria-hidden="true">
            m<span>_</span>
          </span>
          <span>
            moodsh
          </span>
        </a>
        <nav aria-label="Main navigation">
          <a
            href="/themes/"
            aria-current={page === 'themes' ? 'page' : undefined}
          >
            Themes
          </a>
          <a href="/#how-it-works" class="desktop-link">
            How it works
          </a>
          <a href="https://github.com/mager/moodsh" class="desktop-link">
            GitHub <span aria-hidden="true">↗</span>
          </a>
          <a href="/#install" class="nav-install">
            Get moodsh <span aria-hidden="true">↓</span>
          </a>
        </nav>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer class="site-footer">
        <a href="/" class="wordmark">
          <span class="logo" aria-hidden="true">
            m<span>_</span>
          </span>
          <span>Small shell. Big mood.</span>
        </a>
        <div>
          <span>
            Made by <a href="https://www.mager.co">Mager</a>, for the shell fam.
          </span>
          <a href="https://github.com/mager/moodsh/blob/main/LICENSE">
            MIT licensed
          </a>
          <a href="https://github.com/mager/moodsh">Source ↗</a>
        </div>
      </footer>
    </div>
  </body>
</html>
<script>
  if (
    import.meta.env.DEV &&
    new URLSearchParams(location.search).has('audit')
  ) {
    const { default: axe } = await import('axe-core');
    await document.fonts.ready;
    const result = await axe.run(document, {
      runOnly: { type: 'tag', values: ['wcag2a', 'wcag2aa', 'wcag21aa'] },
    });
    console.info(
      'MOODSH_A11Y ' +
        JSON.stringify(
          result.violations.map((item) => ({
            id: item.id,
            impact: item.impact,
            nodes: item.nodes.map((node) => ({
              target: node.target,
              summary: node.failureSummary,
            })),
          })),
        ),
    );
  }
</script>
